#
easyblock = 'CMakeNinja'

name = 'OpenQP'
version = '1.2.0'

homepage = 'https://github.com/Open-Quantum-Platform/openqp/'
description = """Open Quantum Platform (OpenQP) is a quantum chemical platform featuring
 cutting-edge capabilities like Mixed-Reference Spin-Flip (MRSF)-TDDFT with an
 emphasis on open-source ecosystem."""

toolchain = {'name': 'foss', 'version': '2024a'}
toolchainopts = {'usempi': True, 'openmp': True}

source_urls = ['https://github.com/Open-Quantum-Platform/openqp/archive/refs/tags/']
sources = [{'filename': SOURCE_TAR_GZ, 'download_filename': 'v%(version)s.tar.gz'}]
checksums = ['c4957c7357c441e12f747dd5b2a45a8394d85ac2b08d9a7ce0749a42a7fed4d9']

builddependencies = [
    ('CMake', '3.29.3'),
    ('Ninja', '1.12.1'),
    ('scikit-build', '0.17.6'),
    ('meson-python', '0.16.0'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05'),
    ('cffi', '1.16.0'),
    ('dftd4', '3.7.0'),
    ('mpi4py', '4.0.1'),
    ('networkx', '3.4.2'),
    ('hatchling', '1.27.0'),
]

configopts = ' '.join([
    '-DENABLE_PYTHON=ON',
    '-DUSE_LIBINT=OFF',
    '-DENABLE_OPENMP=ON',
    '-DENABLE_MPI=ON',
])

exts_defaultclass = 'PythonPackage'
exts_default_options = {'source_urls': [PYPI_SOURCE]}
exts_list = [
    ('geometric', '1.1.1', {
        'checksums': ['c712c4102bb9db4afab4c7a482289a13d04989735cc1430c89ebb73d587d1d8b'],
    }),
    ('argcomplete', '3.6.3', {
        'checksums': ['62e8ed4fd6a45864acc8235409461b72c9a28ee785a2011cc5eb78318786c89c'],
    }),
    ('Unidecode', '1.4.0', {
        'modulename': 'unidecode',
        'checksums': ['ce35985008338b676573023acc382d62c264f307c8f7963733405add37ea2b23'],
    }),
    ('basis-set-exchange', '0.11', {
        'modulename': 'basis_set_exchange',
        'checksums': ['80f89348e4cc52b12f89391f923564eb5f877e316e2f8fe1e4f28df769d2c852'],
    }),
    ('oqp', version, {
        'nosource': True,
        'start_dir': 'pyoqp',
    }),
    ('libdlfind', '0.0.3', {
        'patches': ['OpenQP-1.2.0-foss-2024a_fix-libdlfind.patch'],
        'checksums': [
            {'libdlfind-0.0.3.tar.gz': '1f74754183432b06c5ada827f2cbf6f9d453c16a7638872db85fae164e88d128'},
            {'OpenQP-1.2.0-foss-2024a_fix-libdlfind.patch':
             '95ec32b23d36522ad4db29f9f61ba9f5636cd49196956aeecba31378a22afdca'},
        ],
    }),
    ('dftd4', '3.7.0', {
        'checksums': ['2e0d3504038358b8a82fdd21912b7765d416a58ebedbdd44f2ca8d2e88339ad7'],
    }),
]

sanity_check_commands = [
    "openqp --help",
    "python -c 'import oqp'",
]

sanity_check_paths = {
    'files': ['bin/openqp'],
    'dirs': [],
}

modextravars = {'OPENQP_ROOT': '%(installdir)s'}

moduleclass = 'chem'
