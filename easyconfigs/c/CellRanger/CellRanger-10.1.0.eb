# The STAR binary included in this version has been vectorized with AVX
# hence it is not recommended for systems that do not support it.

easyblock = 'Tarball'

name = 'CellRanger'
version = "10.1.0"

homepage = 'https://www.10xgenomics.com/support/software/cell-ranger'
description = """Cell Ranger is a set of analysis pipelines that perform sample demultiplexing, barcode processing,
 single cell 3' and 5' gene counting, V(D)J transcript sequence assembly and annotation, and Feature Barcode
 analysis from 10x Genomics Chromium Single Cell data.
"""

toolchain = SYSTEM

download_instructions = """
Download manually from
https://www.10xgenomics.com/support/software/cell-ranger/downloads
"""
docurls = 'https://www.10xgenomics.com/support/software/cell-ranger'
sources = [SOURCELOWER_TAR_GZ]
patches = ['%(namelower)s_slurm_template.patch']
checksums = [
    {'cellranger-10.1.0.tar.gz': 'bce72f4739f2e8193758037ff52e20b85ca716ad44e729dc748d10b25b4ccb9a'},
    {'cellranger_slurm_template.patch': 'd19a51e9496968c977753fea97a29dffafc7162c9b5c275adf463c7ca7177ec6'},
]
sanity_check_paths = {
    'files': ['bin/cellranger'],
    'dirs': ['bin/rna', 'bin/tenkit'],
}

sanity_check_commands = ['cellranger testrun --id=tiny']

moduleclass = 'bio'
