# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Cargo'
name = 'fastVEP'
version = '0.3.0'
versionsuffix = ''

homepage = "https://github.com/Huang-lab/fastVEP"
description = """fastVEP: High-performance Variant Effect Predictor in Rust
 A high-performance Variant Effect Predictor written in Rust. fastVEP predicts the functional consequences of genomic 
 variants (SNPs, insertions, deletions, structural variants) on genes, transcripts, and protein sequences, with direct
 integration of clinical and population databases.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'Huang-lab'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
