# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'MakeCp'
name = 'stringtie'
version = '3.0.3'

homepage = "https://github.com/gpertea/stringtie"
description = """Stringtie employs efficient algorithms for transcript structure recovery and abundance estimation
 from bulk RNA-Seq reads aligned to a reference genome. It takes as input spliced alignments in coordinate-sorted
 SAM/BAM/CRAM format and produces a GTF output which consists of assembled transcript structures and their estimated
 expression levels (FPKM/TPM and base coverage values)."""
docurls = ['https://ccb.jhu.edu/software/stringtie']

toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'optarch': True}

github_account = 'gpertea'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['cb473760912a7a23b09232171902b57a973ca791510c526a7a60f23616008ec8']

buildopts = ['release']
files_to_copy = [(['stringtie'], 'bin')]

builddependencies = [('Autotools', '20250527')]
prebuildopts = [r"sed -ie 's|LIBS|LOCAL_LIBS|g' Makefile && "]
dependencies = [('zlib', '1.3.1')]

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': ['bin'],
}

moduleclass = 'bio'
