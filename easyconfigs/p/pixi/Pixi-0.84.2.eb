builddependencies = [
    ('binutils', '2.44'),
    ('Rust', '1.97.1', '',  ('GCCcore', '14.3.0')),
]

start_dir = 'crates/pixi'

offline = False  # vendoring of git sources not supported in Cargo easyblock yet

# add_tests::add_git_with_tag fails with a directory/file issue
skip_steps = ['test']

sanity_check_paths = {
    'files': ['bin/pixi'],
    'dirs': [],
}

sanity_check_commands = ["pixi --help"]

moduleclass = 'lang'
