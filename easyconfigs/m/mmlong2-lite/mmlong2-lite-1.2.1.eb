easyblock = 'Conda'

name = 'mmlong2-lite'
version = '1.2.1'

homepage = 'https://github.com/Serka-M/mmlong2-lite'
description = """Lightweight workflow for microbial genome recovery using either Nanopore or PacBio HiFi reads.
mmlong2-lite is the microbial genome production part of the mmlong2 pipeline."""

github_account = 'Serka-M'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['d0ce7fe62d6253ac785b6ae543e755ca5c3f19612622557aead8daf935927743']

toolchain = SYSTEM

dependencies = [('Miniforge3', '24.1.2-0')]

extract_sources = True

channels = ['conda-forge', 'bioconda']
requirements = 'snakemake=9.9.0 zenodo_get=1.6.1 pv=1.6.6 pigz=2.8 tar=1.35 rsync=3.4.1'

_zenodo_apptainer_src = '17012181'
local_checksum = '4c7efcca37c5f5ffb1f1c227427d70a44972fe8eb50860e5e11b9b9f5af71eb0'
_apptainer_build_prefix = '/scratch/$USER/sing'
_installed_bin = '%(install_dir)s/bin'

postinstallcmds = [
    'mkdir %(install_dir)s/%(name)s && cp -r %(build_dir)s/%(name)s-%(version)s %(install_dir)s/%(name)s/repo',
    f'mv %(install_dir)s/%(name)s/repo/src/* {_installed_bin}',
    f'chmod +x {_installed_bin}/%(name)s',
    f'sed -i "110s/exit 1/exit 0/" {_installed_bin}/%(name)s',  # return 0 on --help
    f'mkdir -p {_apptainer_build_prefix}',
    f'export EBLOCALMMLONG2SING="{_apptainer_build_prefix}/sing-%(name)s-v%(version_major_minor)s.*.tar.gz"',
    '[[ -e "$(realpath ${EBLOCALMMLONG2SING}*)" ]] || '
    f'{_installed_bin}/zenodo_get -r {_zenodo_apptainer_src} -o {_apptainer_build_prefix}',
    'EBLOCALMMLONG2SING=( "$(realpath ${EBLOCALMMLONG2SING}*)" )',
    f'echo {local_checksum} $EBLOCALMMLONG2SING | sha256sum -c ',
    f'{_installed_bin}/pv $EBLOCALMMLONG2SING | {_installed_bin}/pigz -dc - | tar xf - -C {_apptainer_build_prefix}',
    'apptainer build --fix-perm  ${EBLOCALMMLONG2SING%.tar.gz}{.sif,}',
    'cp -a ${EBLOCALMMLONG2SING%.tar.gz}.sif {_installed_bin}/sing-%(name)s',
    f'sed -i "168,173d" {_installed_bin}/%(name)s'
]

sanity_check_paths = {
    'files': ['bin/%(name)s', 'bin/sing-%(name)s'],
    'dirs': ['include', 'lib'],
}

sanity_check_commands = [
    "%(name)s -h",
]

moduleclass = 'bio'
